{
  "name": "pi-agent-panel",
  "displayName": "pi — Coding Agent",
  "description": "Run the pi coding agent (https://pi.dev) in a VS Code sidebar, driven over its RPC protocol.",
  "version": "0.8.4",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/lwssg182/pi-agent-panel"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onView:piAgent.chat",
    "onView:piAgent.files"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-agent",
          "title": "pi",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "pi-agent": [
        {
          "type": "webview",
          "id": "piAgent.chat",
          "name": "Chat",
          "initialSize": 9,
          "retainContextWhenHidden": true
        },
        {
          "id": "piAgent.files",
          "name": "Drop files",
          "initialSize": 1
        }
      ]
    },
    "configuration": {
      "title": "pi",
      "properties": {
        "pi-agent-panel.piPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `pi` binary. Leave empty to auto-detect (PATH, `~/.npm-global/bin/pi`, `/usr/local/bin/pi`, `/opt/homebrew/bin/pi`)."
        },
        "pi-agent-panel.provider": {
          "type": "string",
          "default": "",
          "description": "Provider to use (e.g. anthropic, openai, google). Leave empty for your pi default."
        },
        "pi-agent-panel.model": {
          "type": "string",
          "default": "",
          "description": "Model to use (e.g. anthropic/claude-sonnet-4). Leave empty for your pi default."
        },
        "pi-agent-panel.continue": {
          "type": "boolean",
          "default": false,
          "description": "Pass --continue so the sidebar resumes the previous pi session of this project."
        },
        "pi-agent-panel.notifyOnFinish": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when pi finishes a run while the chat panel is hidden."
        }
      }
    },
    "commands": [
      {
        "command": "pi-agent-panel.addSelection",
        "title": "pi: Add Selection to Chat"
      },
      {
        "command": "pi-agent-panel.addFile",
        "title": "pi: Add Active File to Chat"
      },
      {
        "command": "pi-agent-panel.rollback",
        "title": "pi: Roll Back to Checkpoint"
      }
    ],
    "keybindings": [
      {
        "command": "piAgent.chat.focus",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;",
        "when": "!terminalFocus"
      },
      {
        "command": "pi-agent-panel.addSelection",
        "key": "ctrl+shift+'",
        "mac": "cmd+shift+'",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  }
}
