{
  "env": {
    "node": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-const-assign": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-unreachable": "warn",
    "no-redeclare": "error",
    "eqeqeq": ["warn", "smart"],
    "no-throw-literal": "warn",
    "no-var": "warn",
    "prefer-const": ["warn", { "destructuring": "all" }]
  },
  "overrides": [
    {
      "files": ["webview.js"],
      "env": {
        "browser": true,
        "node": false
      },
      "globals": {
        "acquireVsCodeApi": "readonly"
      }
    },
    {
      "files": ["markdown.js", "file-input.js"],
      "env": {
        "browser": true,
        "node": true
      }
    }
  ]
}
